# Copy this file to .env and fill in real values.
# Never commit .env to git.

# ── Docker PostgreSQL ─────────────────────────────────────────────────────────
# Used by docker-compose.yml to create the postgres container.
# DATABASE_URL below is auto-overridden by docker-compose to use container hostname.
POSTGRES_USER=stockanalyzer
POSTGRES_PASSWORD=your-secure-db-password

# ── Database ──────────────────────────────────────────────────────────────────
# For local/non-Docker use. Docker compose overrides this automatically.
DATABASE_URL=postgresql://stockanalyzer:your-secure-db-password@localhost:5432/stock_analyzer

# ── Kite Connect ──────────────────────────────────────────────────────────────
KITE_API_KEY=your-kite-api-key
KITE_API_SECRET=your-kite-api-secret
KITE_ADMIN_USER_ID=your-zerodha-user-id

# Optional synchronized WTI + USDINR per-second reference feed.
# The collector stays disabled when the API key is absent.
TWELVE_DATA_API_KEY=your-twelve-data-api-key
TWELVE_DATA_WTI_SYMBOL=WTI/USD
TWELVE_DATA_USDINR_SYMBOL=USD/INR
GLOBAL_REFERENCE_MAX_AGE_SECONDS=10

# ── Zerodha auto-login (kite_auto_login.py) ───────────────────────────────────
ZERODHA_USER_ID=your-zerodha-user-id
ZERODHA_PASSWORD=your-zerodha-password
ZERODHA_TOTP_SECRET=your-totp-base32-secret

# ── Telegram alerts ───────────────────────────────────────────────────────────
# Get token from @BotFather, chat_id from @userinfobot
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# ── Web app (only needed if running stock-analyzer web UI) ────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-a-random-64-char-hex-string
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
ALLOWED_EMAILS=youremail@gmail.com,another@gmail.com
