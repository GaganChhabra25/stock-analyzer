# Copy this file to .env and fill in real values.
# Never commit .env to git.

# Generate a random secret: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-a-random-64-char-hex-string

# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Comma-separated list of Google email addresses allowed to log in.
# Overrides the ALLOWED_EMAILS list in config.py when set.
ALLOWED_EMAILS=youremail@gmail.com,another@gmail.com

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/stock_analyzer

# Telegram alerts — get token from @BotFather, chat_id from @userinfobot
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id
